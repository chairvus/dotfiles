
mpd_music_dir = "~/arth/Music"
mpd_host = "127.0.0.1"
mpd_port = "6600"

## UI
user_interface = "alternative"
song_list_format = "{$8%a - }{$3%t$9}"
song_columns_list_format = "(20)[green]{a} (25)[cyan]{t} (30)[white]{b} (7)[magenta]{l}"
now_playing_prefix = "$b$2"
now_playing_suffix = "$/b$9"

## behavior
autocenter_mode = "yes"
centered_cursor = "yes"
mouse_support = "yes"
playlist_display_mode = "columns"

colors_enabled = "yes"
